# PostgreSQL
POSTGRES_DB=shoe_store
POSTGRES_USER=shoe_store_user
POSTGRES_PASSWORD=your_password

# Local PostgreSQL port
POSTGRES_LOCAL_PORT=5432

# Spring Boot application port
SPRING_LOCAL_PORT=8080

# Java remote debug port
DEBUG_PORT=5005

# Local datasource URL
DATASOURCE_URL=jdbc:postgresql://localhost:5432/shoe_store

# JWT secret key (minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# JWT expiration time in milliseconds
# 3600000 = 1 hour
JWT_EXPIRATION=3600000

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Email sender address used by Brevo
MAIL_FROM=your_verified_sender_email

# Brevo API key
BREVO_API_KEY=your_brevo_api_key

# Frontend application URL
# Used to generate password reset links
FRONTEND_URL=http://localhost:3000
